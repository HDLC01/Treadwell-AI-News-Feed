# ─── Treadwell AI News Feed — Custom Connector (remote MCP) ──────────────────
# Copy to `.env` and fill in. Sensible defaults everywhere; nothing is required
# to start the server (it just has less to talk to).

# Where to read the feed from (read-only). Live site, or a local dev backend.
#   live:  https://newsfeed.wetreadwell.com
#   local: http://127.0.0.1:8890   (DEMO_MODE fixtures when the feed has no creds)
NEWSFEED_BASE_URL=https://newsfeed.wetreadwell.com

# Only needed if the feed's contacts endpoint is gated (CONTACTS_GATE_PASSWORD set
# on the feed). Copy that same value here so the connector can read contacts.
# Leave blank if contacts are open.
NEWSFEED_CONTACTS_KEY=

# ─── Serving ────────────────────────────────────────────────────────────────
MCP_HOST=0.0.0.0
MCP_PORT=8894
# stdio  -> for local testing inside Claude Code
# http   -> Streamable HTTP, for the hosted custom connector (Claude Desktop/web)
MCP_TRANSPORT=http

# A random string baked INTO the connector URL so it isn't publicly discoverable.
# There is no login and nothing to type — you + Kyle just paste the full URL:
#   https://connector.wetreadwell.com/<MCP_PATH_SECRET>/mcp
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(24))"
# Leave blank to serve an OPEN /mcp (anyone with the bare URL can read the feed).
MCP_PATH_SECRET=

# ─── Outreach signature (woven into draft_outreach letters) ──────────────────
# Each caller can override per-call; these are the defaults.
TREADWELL_SIGNER_NAME=Treadwell
TREADWELL_SIGNER_EMAIL=estimating@wetreadwell.com
TREADWELL_PHONE=
