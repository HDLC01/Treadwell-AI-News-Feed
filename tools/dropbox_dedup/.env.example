# Dropbox -> News Feed dedup matcher — config. Copy to `.env`.
# Single-quote the Dropbox paths (they contain `$$` and spaces).

FEED_BASE_URL=https://newsfeed.wetreadwell.com

DROPBOX_POTENTIAL_BIDS='C:\Users\Admin\Treadwell Dropbox\2023 Treadwell Team Folder\Estimating\$$ Potential Bids'
DROPBOX_PROJECTS='C:\Users\Admin\Treadwell Dropbox\2023 Treadwell Team Folder\Projects'

