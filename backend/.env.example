# ─────────────────────────────────────────────────────────────────────────
# Treadwell AI News Feed — backend environment (example)
# Copy to `.env` and fill in. EVERY var is optional with a safe default so the
# app starts bare. Leave Supabase blank to run in DEMO_MODE (sample fixtures).
# ─────────────────────────────────────────────────────────────────────────

# ─── Supabase (leave blank for DEMO_MODE) ────────────────────────────────
# When SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are both set, DEMO_MODE turns
# OFF automatically and the API queries the DB instead of fixtures.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# ─── Demo mode ───────────────────────────────────────────────────────────
# auto: true when Supabase is NOT configured. Force on/off with true/false.
# DEMO_MODE=

# ─── Email (Resend) ──────────────────────────────────────────────────────
# Leave RESEND_API_KEY blank to no-op the mailer (digests build but don't send).
RESEND_API_KEY=
DIGEST_FROM_EMAIL=radar@notify.wetreadwell.com
DIGEST_FROM_NAME=Treadwell Radar

# ─── Geography / radius gate ─────────────────────────────────────────────
# KC origin; data centers count if <= DATA_CENTER_RADIUS_MI, all else <= OTHER_RADIUS_MI.
KC_LAT=39.0997
KC_LON=-94.5786
DATA_CENTER_RADIUS_MI=350
OTHER_RADIUS_MI=70

# ─── Scheduler / pipeline ────────────────────────────────────────────────
# RUN_SCHEDULER only starts the daily cron when ALSO Supabase-configured.
PIPELINE_HOUR=5
PIPELINE_TZ=America/Chicago
RUN_SCHEDULER=false

# ─── Contacts gate (public-page carve-out) ───────────────────────────────
# If set, GET /api/projects/{id}/contacts requires header X-Contacts-Key to match.
# Leave blank to keep contacts open.
CONTACTS_GATE_PASSWORD=

# ─── URLs / CORS ─────────────────────────────────────────────────────────
PUBLIC_BASE_URL=https://newsfeed.wetreadwell.com
# Comma-separated origins, or * in dev.
CORS_ORIGINS=*

# ─── Geocoder politeness ─────────────────────────────────────────────────
NOMINATIM_USER_AGENT=treadwell-newsfeed/1.0 (hanz@wetreadwell.com)

# ─── Environment label ───────────────────────────────────────────────────
ENVIRONMENT=development
