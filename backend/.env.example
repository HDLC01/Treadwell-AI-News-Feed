# ─────────────────────────────────────────────────────────────────────────
# Treadwell AI News Feed — backend environment (example)
# Copy to `.env` and fill in. EVERY var is optional with a safe default so the
# app starts bare. Leave Supabase blank to run in DEMO_MODE (sample fixtures).
# ─────────────────────────────────────────────────────────────────────────

# ─── Supabase (leave blank for DEMO_MODE) ────────────────────────────────
# When SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are both set, DEMO_MODE turns
# OFF automatically and the API queries the DB instead of fixtures.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# ─── Demo mode ───────────────────────────────────────────────────────────
# auto: true when Supabase is NOT configured. Force on/off with true/false.
# DEMO_MODE=

# ─── Email (Resend) ──────────────────────────────────────────────────────
# Leave RESEND_API_KEY blank to no-op the mailer (digests build but don't send).
RESEND_API_KEY=
DIGEST_FROM_EMAIL=radar@notify.wetreadwell.com
DIGEST_FROM_NAME=Treadwell Radar

# ─── Geography / radius gate ─────────────────────────────────────────────
# KC origin; data centers count if <= DATA_CENTER_RADIUS_MI, all else <= OTHER_RADIUS_MI.
KC_LAT=39.0997
KC_LON=-94.5786
DATA_CENTER_RADIUS_MI=350
OTHER_RADIUS_MI=70

# ─── Scheduler / pipeline ────────────────────────────────────────────────
# RUN_SCHEDULER only starts the daily cron when ALSO Supabase-configured.
PIPELINE_HOUR=5
PIPELINE_TZ=America/Chicago
RUN_SCHEDULER=false

# ─── Contacts gate (legacy; superseded by SSO + the service API key) ──────
# No longer used for access control — the app-wide auth gate protects contacts.
CONTACTS_GATE_PASSWORD=

# ─── Auth: Google SSO via the SHARED Treadwell auth Supabase project ──────
# Sign-in reuses the shared Treadwell auth project (same as roadmap/proposal),
# NOT this feed's data project above. Copy these three from that project.
AUTH_SUPABASE_URL=
AUTH_SUPABASE_ANON_KEY=
AUTH_SUPABASE_JWT_SECRET=
AUTH_ALLOWED_DOMAIN=wetreadwell.com
ADMIN_EMAILS=hanz@wetreadwell.com
# DEV-ONLY "Preview as admin" bypass. NEVER set true in production.
DEV_LOGIN=false
# Read-only service key the MCP connector sends as X-Api-Key (set the SAME
# value as NEWSFEED_API_KEY in the connector's .env). Leave blank to disable
# the connector's machine access entirely.
NEWSFEED_API_KEY=

# ─── URLs / CORS ─────────────────────────────────────────────────────────
PUBLIC_BASE_URL=https://newsfeed.wetreadwell.com
# Comma-separated first-party origins. Do NOT use * in production.
CORS_ORIGINS=https://newsfeed.wetreadwell.com

# ─── Geocoder politeness ─────────────────────────────────────────────────
NOMINATIM_USER_AGENT=treadwell-newsfeed/1.0 (hanz@wetreadwell.com)

# ─── Environment label ───────────────────────────────────────────────────
ENVIRONMENT=development
